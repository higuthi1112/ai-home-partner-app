# =====================================================================
# 環境設定のサンプル
# =====================================================================
# このファイルをコピーして「.env」という名前で保存し、値を埋めてください。
#   PowerShell:  Copy-Item .env.example .env
#
# ★注意★
# VITE_ で始まる値は、ビルドすると成果物（JSファイル）に埋め込まれます。
# GitHub Pages に公開すれば誰でも読めるので、**すべて公開情報として扱ってください**。
# パスワードやAWSのアクセスキーを絶対に書かないこと。
# =====================================================================

# --- バックエンドのモード ---------------------------------------------
# mock … すべてローカルで完結する（外部通信ゼロ）。デモ当日の退避先。
# aws  … Lambda 経由で実際にAWSを呼ぶ。
# ※ aws にしても VITE_LAMBDA_URL が空なら、自動的に mock で動きます（事故防止）。
VITE_BACKEND_MODE=mock

# --- Lambda Function URL ----------------------------------------------
# AWS担当から受け取った関数URLを貼ります。
# 例: https://xxxxxxxxxxxxx.lambda-url.ap-northeast-1.on.aws/
VITE_LAMBDA_URL=

# --- 合言葉 -----------------------------------------------------------
# Lambda の環境変数 APP_KEY と同じ値にします。
# いたずらリクエストを軽く弾くためのもので、秘密情報ではありません。
VITE_APP_KEY=

# --- 対象のご本人のID ---------------------------------------------------
# 今回のデモは1名固定なので、この値のままでOKです。
VITE_USER_ID=elder-001

# --- 会話分析の待ち方 --------------------------------------------------
# false … 先に返事をして、分析結果は1〜2秒後に画面へ反映（既定・会話が途切れない）
# true  … 分析結果を待ってから返事をする（回線が速い会場向け）
# ※ URLに ?sync=1 を付ければ、ビルドし直さずその場で切り替えられます。
VITE_ANALYSIS_SYNC=false

# --- 分析の打ち切り時間（ミリ秒）----------------------------------------
# この時間を過ぎたら分析をあきらめます（会話は止めない）。
VITE_ANALYSIS_TIMEOUT_MS=5000

# --- カメラを使うか ----------------------------------------------------
# off にするとカメラ機能を丸ごと無効にします（カメラが無いPCでの開発用）。
VITE_CAMERA=on

# --- 問診の「相槌」を使うか ---------------------------------------------
# on （既定）… 回答のあと、次の質問の前に一言相槌を挟みます（AIが生成）。
# off        … 相槌をやめて、質問だけを読み上げます。
# ※ URLに ?ack=off を付ければ、その場で切り替えられます（当日の退避用）。
# ※ 相槌が失敗しても問診は止まりません（黙って次の質問へ進みます）。
VITE_ACK=on

# --- アバターの話す速さ ------------------------------------------------
# 1.0 が標準で、大きいほど速くなります（例: 1.2 は少し速め）。
# 0.5〜2.0 の範囲に自動で収まるので、極端な値を書いても事故になりません。
# ※ URLに ?rate=1.3 のように付ければ、ビルドし直さずその場で試せます。
#    リハーサルでちょうどよい値を見つけて、ここに書き戻すのがおすすめです。
# ※ 高齢者が聞き取る前提なので、速くしすぎないよう注意してください。
VITE_SPEECH_RATE=1.0

# --- 問診の「追いかけ質問」を使うか --------------------------------------
# on （既定）… 1問目の回答をもとにAIが質問を1つ作り、3問目と差し替えます。
# off        … 台本の固定文だけで進めます。
#
# 仕組み: 1問目に答えた瞬間に裏で作り始めるので、待ち時間は発生しません。
#         間に合わなければ固定文が読まれるだけで、問診は止まりません。
#
# ※ URLに ?followup=off を付ければ、その場で切り替えられます。
#    ★本番でどんな質問が出るかは事前に確認できないので、
#      ?followup=off 付きのURLをブックマークしておくことを強くすすめます。★
VITE_FOLLOWUP=on

# --- アバターの読み上げにクラウドの音声を使うか ------------------------
# on （既定）… Amazon Polly の日本語ニューラル音声（Tomoko）で読み上げます。
#               端末によらず同じ品質になります。
# off        … 端末に内蔵されている読み上げを使います。
#
# ★off にしなくても、クラウドが使えないときは自動で端末の音声に切り替わります★
#   通信が落ちても無音にはなりません。
#
# ※ URLに ?voice=device を付ければ、その場で端末の音声に戻せます（当日の退避用）。
VITE_CLOUD_VOICE=on
